# =========================================================
# AI Phishing Detector - Environment Variables Template
# Copy this file to .env or set these in your Cloud Dashboard
# =========================================================

# Flask Secret Key (generate a random string for production)
SECRET_KEY=change-this-to-a-secure-random-key

# Scanner Frequency in Seconds (60 = 1 minute)
SCAN_INTERVAL=60

# Full Inbox Scan (true = scans entire inbox, false = unread emails only)
SCAN_FULL_INBOX=false
MAX_INBOX_EMAILS=50

# Desktop Notifications (Set to false for cloud deployments)
ENABLE_DESKTOP_NOTIFICATIONS=false

# Notification Email (optional secondary email to receive phishing alerts)
NOTIFY_EMAIL=your-alert-email@gmail.com

# =========================================================
# Universal Email Connector (IMAP - Connect ANY Email)
# =========================================================
# Works for Gmail, Outlook, Yahoo, iCloud, or any custom domain.
#
# Common IMAP Servers:
#   Gmail:   imap.gmail.com        (Port: 993) -> Requires 16-char App Password
#   Outlook: outlook.office365.com (Port: 993)
#   Yahoo:   imap.mail.yahoo.com   (Port: 993)
#   iCloud:  imap.mail.me.com      (Port: 993)

IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_ACCOUNT=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
